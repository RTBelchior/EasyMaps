<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perfil"
            android:textColor="#0F172A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Avatar Section -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp">

            <!-- Background Circle with Initials -->
            <FrameLayout
                android:id="@+id/container_avatar_initials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle">

                <TextView
                    android:id="@+id/tv_avatar_initials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="#1E40AF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="MS" />
            </FrameLayout>

            <!-- Profile Photo (if taken) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Fotografia de perfil"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/CircleImage" />
        </FrameLayout>

        <!-- Alterar fotografia button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_photo"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="Alterar fotografia"
            android:textColor="#2563EB"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Field 1: Nome -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="Nome"
            android:textColor="#475569"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="O teu nome"
                android:inputType="textPersonName"
                android:paddingHorizontal="16dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="15sp"
                tools:text="Maria Silva" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Field 2: Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="Email"
            android:textColor="#475569"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tv_email"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:textColor="#0F172A"
                android:textSize="15sp"
                tools:text="maria@email.pt" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Sincronização Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sync"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:rippleColor="#20000000"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Sincronização"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sync_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="#15803D"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Tudo sincronizado" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Guardar alterações Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2563EB"
            android:text="Guardar alterações"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:elevation="2dp" />

        <!-- Terminar sessão Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FFFFFF"
            android:text="Terminar sessão"
            android:textColor="#DC2626"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="#DC2626"
            app:strokeWidth="1.5dp" />
    </LinearLayout>
</ScrollView>
